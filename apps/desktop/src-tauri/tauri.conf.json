{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orchester",
  "version": "0.1.2",
  "identifier": "io.github.diewehmut.orchester",
  "build": {
    "beforeDevCommand": {
      "cwd": "../..",
      "script": "pnpm --filter @orchester/web dev -- --strictPort"
    },
    "beforeBuildCommand": {
      "cwd": "../..",
      "script": "pnpm --filter @orchester/web build"
    },
    "devUrl": "http://127.0.0.1:4173",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Orchester",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": false
  }
}
