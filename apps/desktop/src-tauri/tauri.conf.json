{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orchester",
  "version": "0.2.0",
  "identifier": "io.github.diewehmut.orchester",
  "build": {
    "beforeDevCommand": {
      "cwd": "../../..",
      "script": "pnpm --filter @orchester/web dev -- --strictPort"
    },
    "beforeBuildCommand": {
      "cwd": "../../..",
      "script": "pnpm --filter @orchester/web build"
    },
    "devUrl": "http://127.0.0.1:4173",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; navigate-to 'self'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:4173 ws://127.0.0.1:4173; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; navigate-to 'self'",
      "freezePrototype": true,
      "dangerousDisableAssetCspModification": false,
      "assetProtocol": {
        "enable": false,
        "scope": []
      },
      "capabilities": ["default"]
    },
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Orchester",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#101010",
        "shadow": true,
        "resizable": true,
        "devtools": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "dieWehmut",
    "resources": {
      "../../web/dist/": "web/"
    },
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "compression": "lzma",
        "languages": ["English", "SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  }
}
