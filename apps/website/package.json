{
  "name": "@orchester/website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Static GitHub Pages site for Orchester",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@lucide/vue": "^1.32.0",
    "@orchester/design": "workspace:*",
    "vue": "3.5.18",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@types/node": "^25.3.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^30.0.1",
    "vite": "^7.1.2",
    "vue-tsc": "^3.2.5"
  }
}
